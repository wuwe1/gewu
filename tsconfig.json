{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["node"]
	},
	"include": ["bin", "src"]
}
